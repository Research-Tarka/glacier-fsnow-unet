# ----------------------------------------------------------------------
# glacier-fsnow-unet — example environment file
#
# Copy to .env and fill in real values. Never commit the real .env (it is
# gitignored). Referenced from configs/config.yaml via ${VAR} placeholders.
# ----------------------------------------------------------------------

# Root directory for downloaded raw data (glaciers, DEM, scenes)
DATA_ROOT=CHANGE_ME

# Root directory for pipeline outputs (inference maps, stats, SGV)
OUTPUT_ROOT=CHANGE_ME

# Root directory for trained model checkpoints
MODEL_ROOT=CHANGE_ME

# Google Earth Engine project id used for scene download (see
# scene_download.ee_project_default / splits[].ee_project in the config, and
# --ee-project on scripts/04_download_scenes.py). This is the exact variable
# name glacier_fsnow_unet.scenes.gee_auth.resolve_project() looks up.
EE_PROJECT=CHANGE_ME

# Path to a Google Earth Engine service-account JSON key (leave unset to use
# interactive OAuth2 via `earthengine authenticate`, stored outside this repo
# in ~/.config/earthengine/)
GEE_SERVICE_ACCOUNT_JSON=CHANGE_ME

# Google Drive OAuth client id/secret, only needed if scene_download.drive_export
# is enabled in the config (batch GEE exports to Drive)
GOOGLE_DRIVE_CLIENT_ID=CHANGE_ME
GOOGLE_DRIVE_CLIENT_SECRET=CHANGE_ME
